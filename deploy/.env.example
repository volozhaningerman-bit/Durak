# Public hostname pointed to this VPS, without https://
DOMAIN=durak.example.com

# Telegram bot token from @BotFather. Never commit a real token.
BOT_TOKEN=

# Random secret used by Telegram to authenticate webhook requests.
# Example: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Database credentials used only inside Docker network.
POSTGRES_DB=durak
POSTGRES_USER=durak
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Player has this long to reconnect before a disconnect loss.
RECONNECT_GRACE_MS=60000

# Private room waiting lifetime before automatic cleanup.
PRIVATE_LOBBY_TTL_MS=3600000
